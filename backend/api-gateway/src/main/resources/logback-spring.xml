<configuration>
    <springProperty scope="context" name="appName" source="spring.application.name"/>

    <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
        <http>
            <url>http://loki:3100/loki/api/v1/push</url>
        </http>
        <format>
            <label>
                <pattern>app=${appName},host=${HOSTNAME},level=%level</pattern>
            </label>
            <message class="com.github.loki4j.logback.JsonLayout">
                <timestampFieldName>time</timestampFieldName>
                <messageFormatter class="com.github.loki4j.logback.MessageFormatter">
                    <pattern>%msg %nopex</pattern>
                </messageFormatter>
            </message>
        </format>
    </appender>

    <logger name="org.springframework.cloud.gateway" level="OFF"/>
    <logger name="org.springframework.http.server.reactive" level="OFF"/>
    <logger name="org.springframework.web.reactive" level="OFF"/>
    <logger name="reactor.netty" level="OFF"/>

    <root level="OFF">
        <appender-ref ref="LOKI"/>
    </root>

    <logger name="com.streaming.gateway.config.AccessControlLoggingFilter" level="WARN"/>
    <logger name="com.streaming.gateway.config.SecurityConfig" level="WARN"/>

</configuration>
